#!/bin/bash

# Saved Wi-Fi profile reads and edits for the network panel's settings card,
# and the roaming check its service runs. Profiles are addressed by UUID; the
# SSID is always the last field, and control bytes in it (tab, newline, ESC,
# DEL) print as ?. Secrets go to stdout only, never argv.
#
#   wifi-settings list                    uuid \t autoconnect \t active \t timestamp \t priority \t ssid-hex \t ssid
#   wifi-settings show <uuid>             key \t value lines
#   wifi-settings password <uuid>         the PSK or WEP key
#   wifi-settings autoconnect <uuid> yes|no
#   wifi-settings priority <uuid> <-999..999>
#   wifi-settings forget <uuid>
#   wifi-settings roaming [on|off]        print or set whether `roam` acts
#   wifi-settings roam                    one roaming check (see roam() below)

set -euo pipefail

# XDG_STATE_HOME counts only when absolute, as the XDG Base Directory spec says.
[[ ${XDG_STATE_HOME:-} == /* ]] || XDG_STATE_HOME=$HOME/.local/state
STATE_DIR=$XDG_STATE_HOME/omarchy-wifi-settings
MIN_SIGNAL=${WIFI_ROAM_MIN_SIGNAL:-40}
# Only a plain number reaches arithmetic; anything else is the default, silently.
# Base 10, or a leading zero would make it octal.
[[ $MIN_SIGNAL =~ ^[0-9]{1,3}$ ]] || MIN_SIGNAL=40
MIN_SIGNAL=$((10#$MIN_SIGNAL))
FAILED_HOLD=1800

usage() {
  sed -n '3,15p' "$0" >&2
  exit 2
}

wifi_uuids() {
  nmcli --get-values UUID,TYPE connection show | awk -F: '$2 == "802-11-wireless" { print $1 }'
}

require_wifi() {
  [[ $(nmcli --get-values connection.type connection show uuid "$1" 2>/dev/null) == "802-11-wireless" ]] || {
    echo "Not a saved Wi-Fi network" >&2
    exit 1
  }
}

# Fills the associative array `f` with the profile's fields. nmcli prints
# them in its own section order, so they are keyed, never positional. An SSID is
# up to 32 arbitrary bytes, newlines included, so it is read on its own and
# never split into lines.
load_profile() {
  local key value
  f=()
  while IFS=: read -r key value; do
    f[$key]=$value
  done < <(nmcli --escape no --terse --fields \
    connection.autoconnect,connection.autoconnect-priority,connection.timestamp,GENERAL.STATE,802-11-wireless-security.key-mgmt,802-11-wireless.hidden,802-11-wireless.mode \
    connection show uuid "$1")
  value=$(nmcli --escape no --get-values 802-11-wireless.ssid connection show uuid "$1"; echo .)
  value=${value%.}
  f[802-11-wireless.ssid]=${value%$'\n'}
  f[active]=no
  [[ ${f[GENERAL.STATE]:-} == activated ]] && f[active]=yes
  return 0
}

declare -A f

# Upper-case hex of a string's bytes, the form of nmcli's SSID-HEX.
hex() {
  printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n' | tr a-f A-F
}

# One line per field, and nothing a terminal or log would act on: every control
# byte (C0, so tab, newline, CR and ESC, and DEL) becomes ?.
one_line() {
  printf '%s' "${1//[[:cntrl:]]/?}"
}

# Prints "device<TAB>active-uuid" for the connected Wi-Fi device, if any.
connected_wifi() {
  local dev type state
  while IFS=: read -r dev type state; do
    [[ $type == wifi && $state == connected ]] || continue
    printf '%s\t%s\n' "$dev" "$(nmcli --get-values GENERAL.CON-UUID device show "$dev")"
    return 0
  done < <(nmcli --terse --fields DEVICE,TYPE,STATE device)
  return 1
}

# NetworkManager weighs connection.autoconnect-priority only while it is
# choosing a network; it never leaves an active one for a better one. On a
# lower-priority network this rescans and brings up the highest-priority saved
# network in range at WIFI_ROAM_MIN_SIGNAL or more, ties to the stronger one.
#
# Roaming moves only between client connections, 802-11-wireless.mode
# infrastructure (empty is NetworkManager's default, the same): while the
# active profile is a hotspot (ap), ad-hoc or mesh network it does nothing, not
# even a scan, and such a profile is never a target.
#
# Anyone can broadcast a saved network's name, so only profiles that
# authenticate the network are targets: key-mgmt wpa-psk, sae, wpa-eap or
# wpa-eap-suite-b-192, never open, OWE or WEP. Such a profile is in range only
# through an access point whose SECURITY matches it: wpa-psk needs WPA1 or WPA2,
# sae needs WPA3, both without 802.1X; wpa-eap needs 802.1X. What remains is an
# access point that knows the saved password.
#
# A choice made while the better network was already in range is respected:
# networks at or above the floor on the first check of a new connection are
# held until they drop out of the scan list and return. A failed switch is held
# for FAILED_HOLD seconds (30 min) from the attempt, whether the network leaves
# range or the active connection changes, so a wrong saved password or a fake
# access point does not drop the current network every check.
#
# State file: line 1 the active UUID (empty while disconnected), then one line
# per hold: `uuid` for a choice, `uuid<TAB>until` for a failed switch, with
# until in Unix epoch seconds.
roam() {
  local state=$STATE_DIR/roam
  [[ ! -f $STATE_DIR/roaming-off ]] || return 0
  local now prev_active="" h until
  local -a chosen=()
  declare -A timed=()
  printf -v now '%(%s)T' -1
  if [[ -f $state ]]; then
    {
      IFS= read -r prev_active || true
      while IFS=$'\t' read -r h until; do
        [[ -n $h ]] || continue
        if [[ -z $until ]]; then
          chosen+=("$h")
        elif [[ $until =~ ^[0-9]{1,12}$ ]] && (( until > now )); then
          timed[$h]=$until
        fi
      done
    } <"$state"
  fi

  local line dev active
  line=$(connected_wifi) || {
    if (( ${#timed[@]} )); then save_roam_state ""; else rm -f "$state"; fi
    return 0
  }
  IFS=$'\t' read -r dev active <<<"$line"
  [[ -n $active && $active != -- ]] || return 0

  local id auth current_priority=0
  local -a cand_uuid=() cand_priority=() cand_ssid=() cand_hex=() cand_auth=()
  while read -r id; do
    load_profile "$id"
    [[ $id == "$active" ]] && current_priority=${f[connection.autoconnect-priority]:-0}
    # A hotspot or ad-hoc network the laptop serves is never roamed away from:
    # no scan, and holds by choice end with the connection they were made on.
    if [[ $id == "$active" && ${f[802-11-wireless.mode]:-infrastructure} != infrastructure ]]; then
      save_roam_state "$active"
      return 0
    fi
    [[ ${f[connection.autoconnect]:-} == yes && -n ${f[802-11-wireless.ssid]:-} ]] || continue
    # Only client profiles: never a hotspot (ap), ad-hoc or mesh network.
    [[ ${f[802-11-wireless.mode]:-infrastructure} == infrastructure ]] || continue
    # Only profiles that authenticate the network: open, OWE and WEP never.
    case ${f[802-11-wireless-security.key-mgmt]:-} in
    wpa-psk) auth=psk ;;
    sae) auth=sae ;;
    wpa-eap | wpa-eap-suite-b-192) auth=eap ;;
    *) continue ;;
    esac
    cand_uuid+=("$id")
    cand_auth+=("$auth")
    cand_priority+=("${f[connection.autoconnect-priority]:-0}")
    cand_ssid+=("${f[802-11-wireless.ssid]}")
    cand_hex+=("$(hex "${f[802-11-wireless.ssid]}")")
  done < <(wifi_uuids)

  # Nothing ranks above the current network: no scan, nothing held.
  local i any=0
  for i in "${!cand_uuid[@]}"; do
    (( cand_priority[i] > current_priority )) && any=1
  done
  if (( ! any )); then
    save_roam_state "$active"
    return 0
  fi

  # Strongest signal per visible SSID and security class, keyed
  # "class:SSID-HEX". Scan results come from any nearby access point: the raw
  # SSID is never parsed, SECURITY must be nmcli's upper-case word list, and
  # only plain numbers reach arithmetic, which Bash evaluates recursively.
  local signal security ssid_hex word key sec_re='^[A-Z0-9. -]*$'
  local -a words
  declare -A visible=() has=()
  while IFS=: read -r signal security ssid_hex; do
    [[ $signal =~ ^[0-9]+$ && $ssid_hex =~ ^[0-9A-Fa-f]+$ && $security =~ $sec_re ]] || continue
    ssid_hex=${ssid_hex^^}
    has=()
    read -ra words <<<"$security"
    for word in "${words[@]}"; do has[$word]=1; done
    for auth in psk sae eap; do
      case $auth in
      psk) [[ -n ${has[WPA1]:-}${has[WPA2]:-} && -z ${has[802.1X]:-} ]] || continue ;;
      sae) [[ -n ${has[WPA3]:-} && -z ${has[802.1X]:-} ]] || continue ;;
      eap) [[ -n ${has[802.1X]:-} ]] || continue ;;
      esac
      key=$auth:$ssid_hex
      (( signal > ${visible[$key]:-0} )) && visible[$key]=$signal
    done
  done < <(nmcli --terse --fields SIGNAL,SECURITY,SSID-HEX device wifi list ifname "$dev" --rescan auto)

  # Holds by choice belong to the connection they were made on.
  local -a held=()
  local first_check=0
  if [[ -f $state && $prev_active == "$active" ]]; then
    held=("${chosen[@]}")
  else
    first_check=1
  fi

  local best=-1 best_signal=0 is_held
  local -a next_held=()
  for i in "${!cand_uuid[@]}"; do
    (( cand_priority[i] > current_priority )) || continue
    # A failed switch ignores the scan until its hold ends.
    [[ -z ${timed[${cand_uuid[i]}]:-} ]] || continue
    signal=${visible[${cand_auth[i]}:${cand_hex[i]}]:-0}
    is_held=0
    for h in "${held[@]}"; do [[ $h == "${cand_uuid[i]}" ]] && is_held=1; done

    if (( first_check )); then
      (( signal >= MIN_SIGNAL )) && next_held+=("${cand_uuid[i]}")
      continue
    fi
    # Out of range clears the hold, so it counts as new when it returns.
    if (( is_held )); then
      (( signal > 0 )) && next_held+=("${cand_uuid[i]}")
      continue
    fi
    (( signal >= MIN_SIGNAL )) || continue
    if (( best < 0 || cand_priority[i] > cand_priority[best] ||
          (cand_priority[i] == cand_priority[best] && signal > best_signal) )); then
      best=$i best_signal=$signal
    fi
  done

  save_roam_state "$active" "${next_held[@]}"

  if (( first_check && ${#next_held[@]} )); then
    echo "holding: on priority $current_priority by choice while a higher-priority network is in range"
  fi
  (( best >= 0 )) || return 0

  echo "switching to $(one_line "${cand_ssid[best]}") (priority ${cand_priority[best]}, signal $best_signal) from priority $current_priority"
  if ! nmcli --wait 30 connection up uuid "${cand_uuid[best]}" ifname "$dev" >/dev/null; then
    echo "switch to $(one_line "${cand_ssid[best]}") failed, not trying it again for $((FAILED_HOLD / 60)) min"
    printf -v now '%(%s)T' -1
    timed[${cand_uuid[best]}]=$((now + FAILED_HOLD))
    save_roam_state "$active" "${next_held[@]}"
  fi
  return 0
}

# Writes roam()'s state file: the active UUID, the holds by choice given after
# it, then the failed-switch holds in roam()'s `timed` map.
save_roam_state() {
  local h
  {
    printf '%s\n' "$1"
    shift
    if (( $# )); then printf '%s\n' "$@"; fi
    for h in "${!timed[@]}"; do printf '%s\t%s\n' "$h" "${timed[$h]}"; done
  } >"$STATE_DIR/roam"
}

cmd=${1:-}
uuid=${2:-}

case "$cmd" in
list)
  while read -r id; do
    load_profile "$id"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "${f[connection.autoconnect]:-}" "${f[active]}" \
      "${f[connection.timestamp]:-0}" "${f[connection.autoconnect-priority]:-0}" "$(hex "${f[802-11-wireless.ssid]:-}")" \
      "$(one_line "${f[802-11-wireless.ssid]:-}")"
  done < <(wifi_uuids)
  ;;
show)
  [[ -n $uuid ]] || usage
  require_wifi "$uuid"
  load_profile "$uuid"
  printf 'uuid\t%s\nautoconnect\t%s\npriority\t%s\ntimestamp\t%s\nactive\t%s\nkeymgmt\t%s\nhidden\t%s\nssidhex\t%s\nssid\t%s\n' \
    "$uuid" "${f[connection.autoconnect]:-}" "${f[connection.autoconnect-priority]:-0}" "${f[connection.timestamp]:-0}" "${f[active]}" \
    "${f[802-11-wireless-security.key-mgmt]:-}" "${f[802-11-wireless.hidden]:-}" "$(hex "${f[802-11-wireless.ssid]:-}")" \
    "$(one_line "${f[802-11-wireless.ssid]:-}")"
  ;;
password)
  [[ -n $uuid ]] || usage
  require_wifi "$uuid"
  # One read per field, never split on `:`: a key may end in or hold `:` and
  # newlines. The `.` keeps trailing newlines from $( ); then nmcli's own goes.
  f=()
  for key in 802-11-wireless-security.key-mgmt 802-11-wireless-security.psk 802-11-wireless-security.wep-key0; do
    value=$(nmcli --show-secrets --escape no --get-values "$key" connection show uuid "$uuid"; echo .)
    value=${value%.}
    f[$key]=${value%$'\n'}
  done
  key_management=${f[802-11-wireless-security.key-mgmt]:-}
  password=${f[802-11-wireless-security.psk]:-}
  [[ $key_management != *eap* && $key_management != *ieee8021x* ]] || {
    echo "Enterprise Wi-Fi has no shareable password" >&2
    exit 1
  }
  # NetworkManager models WEP as key-mgmt "none" plus a wep-key.
  [[ -n $key_management && $key_management != none ]] || password=${f[802-11-wireless-security.wep-key0]:-}
  [[ -n $password ]] || { echo "No saved password" >&2; exit 1; }
  printf '%s\n' "$password"
  ;;
autoconnect)
  [[ -n $uuid && ${3:-} =~ ^(yes|no)$ ]] || usage
  require_wifi "$uuid"
  nmcli connection modify uuid "$uuid" connection.autoconnect "$3"
  ;;
priority)
  [[ -n $uuid && ${3:-} =~ ^-?[0-9]{1,3}$ ]] || usage
  require_wifi "$uuid"
  nmcli connection modify uuid "$uuid" connection.autoconnect-priority "$3"
  ;;
forget)
  [[ -n $uuid ]] || usage
  require_wifi "$uuid"
  nmcli connection delete uuid "$uuid" >/dev/null
  ;;
roaming)
  mkdir -p "$STATE_DIR"
  case "${2:-}" in
  "") [[ -f $STATE_DIR/roaming-off ]] && echo off || echo on ;;
  on) rm -f "$STATE_DIR/roaming-off" ;;
  off) : >"$STATE_DIR/roaming-off" ;;
  *) usage ;;
  esac
  ;;
roam)
  mkdir -p "$STATE_DIR"
  roam
  ;;
*)
  usage
  ;;
esac
